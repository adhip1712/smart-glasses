# Groq AI
GROQ_API_KEY=your_groq_api_key_here

# Audio / music providers (backend-only)
NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
NAVIDROME_ENABLED=true

YOUTUBE_API_KEY=

# Weather
WEATHER_PROVIDER=real
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_BASE_URL=https://api.weatherapi.com

# Navigation
NAVIGATION_PROVIDER=real
NAVIGATION_API_KEY=your_navigation_api_key_here
NAVIGATION_BASE_URL=https://nominatim.openstreetmap.org

# Device provisioning (see docs/device-lifecycle.md)
# Set these in production: rotating them invalidates stored device credentials.
DEVICE_TOKEN_PEPPER=
DEVICE_TOKEN_KEY=
DEVICE_HEARTBEAT_INTERVAL_SECONDS=10
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=30
DEVICE_PAIRING_CODE_TTL_SECONDS=900

# ESP32-CAM (AI Thinker + OV2640) - see docs/camera-integration.md
# Leave ESP32_CAM_IP empty to learn the address from the device registry
# (the IP the board reports in its heartbeat), which survives DHCP changes.
CAMERA_SOURCE=auto
ESP32_CAM_IP=
ESP32_CAM_PORT=81
ESP32_CAM_STREAM_URL=
ESP32_CAM_SNAPSHOT_URL=
ESP32_CAM_TIMEOUT=4
ESP32_CAM_MAX_FRAME_BYTES=2000000
ESP32_CAM_FRAME_MAX_AGE=10
# Only used when CAMERA_SOURCE=webcam (PC webcam through OpenCV).
ESP32_CAM_WEBCAM_INDEX=0
